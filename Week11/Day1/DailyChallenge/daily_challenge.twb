                    <zone h='38618' id='20' name='Video Game Sales by Region, 1985-2016 (millions of units)' param='[federated.1yxtpgc0h04q1m17f2k8r04orpbz].[none:Year:qk]' type-v2='filter' values='database' w='10010' x='89522' y='44079'>
