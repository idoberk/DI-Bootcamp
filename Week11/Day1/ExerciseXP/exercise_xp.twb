    <worksheet name='Exercise 6'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>Question: Which genres depend most on the Japanese market?

Explanation: Publishers deciding where to launch or localize a game need to know which genres sell in which regions. We find that Role-Playing games get a much larger share of their sales in Japan than any other genre, while Shooters barely sell there.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vgsales' name='federated.0xwt2ba1hbyafr1g7ux5l1qigdqc' />
          </datasources>
          <datasource-dependencies datasource='federated.0xwt2ba1hbyafr1g7ux5l1qigdqc'>
            <column caption='JP Market Share' datatype='real' default-format='p0.00%' name='[Calculation_1181215225651207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([JP_Sales]) / SUM([Global_Sales])' />
            </column>
            <column datatype='string' name='[Genre]' role='dimension' type='nominal' />
            <column caption='Global Sales' datatype='real' name='[Global_Sales]' role='measure' type='quantitative' />
            <column caption='JP Sales' datatype='real' name='[JP_Sales]' role='measure' type='quantitative' />
            <column-instance column='[Genre]' derivation='None' name='[none:Genre:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1181215225651207]' derivation='User' name='[usr:Calculation_1181215225651207:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0xwt2ba1hbyafr1g7ux5l1qigdqc].[none:Genre:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0xwt2ba1hbyafr1g7ux5l1qigdqc].[usr:Calculation_1181215225651207:qk]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
        <style />
