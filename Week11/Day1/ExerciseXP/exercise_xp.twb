      <aliases enabled='yes' />
      <column caption='Profitability Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1181215221243904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Global_Sales]) - SUM(([Global_Sales]) * 0.30)) / SUM([Global_Sales])' />
      </column>
      <column caption='Estimated Profit' datatype='real' name='[Calculation_1181215222337537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales]) * (1 - 0.30)' />
      </column>
      <column caption='Sales Performance Index' datatype='integer' name='[Calculation_1181215223246850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Global_Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY Growth Rate' datatype='real' default-format='p0.00%' name='[Calculation_1181215224188932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Global_Sales]) - LOOKUP(SUM([Global_Sales]), -1)) / LOOKUP(SUM([Global_Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Genre Dominance Ratio' datatype='real' default-format='p0.00%' name='[Calculation_1181215225208838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales]) / TOTAL(SUM([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='JP Market Share' datatype='real' default-format='p0.00%' name='[Calculation_1181215225651207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([JP_Sales]) / SUM([Global_Sales])' />
      </column>
      <column caption='EU Sales (bin)' datatype='integer' name='[EU Sales (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[EU_Sales]' peg='0' size='5' />
      </column>
